{
  "name": "piecepool",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI knowledge workspace for university students — Tauri + Rust + React/TS",
  "license": "UNLICENSED",
  "author": "gosu1",
  "homepage": "https://github.com/gosu1/piecepool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosu1/piecepool.git"
  },
  "bugs": {
    "url": "https://github.com/gosu1/piecepool/issues"
  },
  "keywords": [
    "knowledge-management",
    "knowledge-graph",
    "wiki",
    "tauri",
    "local-first",
    "llm",
    "openai",
    "note-taking"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && npm run check:scripts",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:types": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "gen:llm-schema": "node scripts/gen-llm-schema.mjs",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "chunk": "tsx --env-file-if-exists=.env scripts/chunk-preview.ts",
    "promote": "tsx --env-file-if-exists=.env scripts/promote-preview.ts",
    "classify": "tsx --env-file-if-exists=.env scripts/classify-preview.ts",
    "provenance": "tsx --env-file-if-exists=.env scripts/provenance-preview.ts",
    "tauri": "tauri",
    "eval:feynman": "tsx --env-file-if-exists=.env scripts/feynman-eval.ts",
    "eval:ab": "tsx --env-file-if-exists=.env scripts/model-ab.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/d3-force": "^3.0.10",
    "@uiw/react-codemirror": "^4.25.10",
    "ajv": "^8.20.0",
    "cytoscape": "^3.34.0",
    "d3-force": "^3.0.0",
    "katex": "^0.16.47",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
