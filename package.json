{
  "name": "piecepool",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI knowledge workspace for university students — Tauri + Rust + React/TS",
  "license": "UNLICENSED",
  "author": "gosu1",
  "homepage": "https://github.com/gosu1/piecepool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosu1/piecepool.git"
  },
  "bugs": {
    "url": "https://github.com/gosu1/piecepool/issues"
  },
  "keywords": [
    "knowledge-management",
    "knowledge-graph",
    "wiki",
    "tauri",
    "local-first",
    "llm",
    "openai",
    "note-taking"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "gen:types": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "gen:llm-schema": "node scripts/gen-llm-schema.mjs",
    "eval": "tsx scripts/eval.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ajv": "^8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
