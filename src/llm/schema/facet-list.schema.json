{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FacetList",
  "type": "object",
  "additionalProperties": false,
  "required": ["facets"],
  "properties": {
    "facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["definition", "mechanism", "rationale", "boundary", "connection", "example"]
          }
        }
      }
    }
  }
}
