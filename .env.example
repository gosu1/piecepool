# PiecePool 환경변수 예시 — 이 파일을 `.env`로 복사해 값을 채우세요.
# `.env`는 .gitignore 처리됨. 절대 키를 커밋하지 마세요.
#
# ⚠️ 아래 GEMINI_API_KEY/LINER_API_KEY 는 CLI 스크립트 전용입니다 (`npm run eval:feynman`, `npm run chunk` 등).
#    데스크톱 앱(`npm run tauri dev/build`)은 런타임에 이 값을 읽지 않습니다.
#    앱에서는 좌하단 계정 → 설정에서 키를 입력하세요(이 기기에만 저장).
#
# ★ 데모 배포용 빌드 주입 키: VITE_GEMINI_API_KEY (아래 참고)
#    이 값만은 **빌드 시** 앱 번들에 폴백 키로 박힌다 — 심사위원이 키 발급 없이 바로 쓰게 하는 용도.
#
# ⚠️ 셸에 이미 export 된 환경변수가 `.env` 보다 **우선**합니다(Node `--env-file` 규칙).
#    `.env`를 고쳤는데 안 바뀌면 `echo $GEMINI_API_KEY` 로 셸 쪽을 먼저 확인하세요.

# Gemini API 키 (Wiki 생성 · 파인만식 되묻기 · 임베딩) — CLI 스크립트 전용
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ★ (선택) 데모 배포용 앱 폴백 키 — 빌드 시 앱 번들에 박힌다.
#   심사위원이 키 발급 없이 바로 AI 기능을 쓰게 하려면 이 파일을 `.env.local` 로 복사해 값을 넣고
#   `npm run tauri build`. .env.local 은 gitignore 되어 커밋·소스 zip 에 안 들어간다.
#   앱 설정 모달에 저장된 키가 있으면 그 키가 우선(이 값은 폴백).
#   ⚠️ 이 키는 배포 번들에 박혀 추출 가능 — 한도 낮은 전용 키를 쓰고 심사 후 폐기할 것.
#   CI 빌드는 이 파일 대신 리포지토리 Secret(Settings → Secrets → Actions)의 같은 이름 값을 쓴다.
VITE_GEMINI_API_KEY=

# Liner API 키 (정보 간극 메우기 label↔user — 출처 검색 · fact-check)
LINER_API_KEY=

# (선택) Liner API endpoint override — 비우면 기본값 사용
LINER_API_ENDPOINT=

# (선택) 모델명 override — 비우면 기본값 사용
PIECEPOOL_LLM_MODEL=
PIECEPOOL_EMBED_MODEL=
